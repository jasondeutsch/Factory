{
  "name": "golang",
  "owner": "coordinator",
  "defaults": {
    "runner": "pi",
    "provider": "team-gateway",
    "model": "your-model-id",
    "thinking": "medium",
    "tools": [
      "read",
      "bash",
      "edit",
      "write",
      "grep",
      "find",
      "ls"
    ],
    "mcps": [
      "comms"
    ],
    "check_timeout_seconds": 30
  },
  "providers": {
    "team-gateway": {
      "baseUrl": "https://gateway.example.com/v1",
      "api": "openai-completions",
      "apiKey": "${TEAM_MODEL_API_KEY}",
      "models": [
        {
          "id": "your-model-id"
        }
      ]
    }
  },
  "mcps": {
    "comms": {
      "url": "http://127.0.0.1:8090/mcp",
      "description": "Factory task status, inbox messages, decisions, evidence, usage, and reports.",
      "exposure": "codemode"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp/readonly",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      },
      "description": "Read requested Linear issues, comments, projects, and related planning context.",
      "exposure": "codemode"
    },
    "gopls": {
      "command": "gopls",
      "args": [
        "mcp"
      ],
      "description": "Explore and diagnose the Go project using gopls.",
      "exposure": "codemode"
    }
  },
  "extensions": {
    "ralph": {
      "source": "git:github.com/edxeth/pi-ralph-loop@108823f8d1e2089fec1f7202ca3a8905d12df574",
      "skills": [],
      "prompts": [],
      "themes": []
    }
  },
  "agents": [
    {
      "name": "coordinator",
      "path": "../../orchestrator",
      "skills": [
        "../../orchestrator/comms/skills/task-comms"
      ]
    },
    {
      "name": "architect",
      "path": "../../resources/agents/architect",
      "skills": [
        "../../orchestrator/comms/skills/task-comms",
        "../../resources/agents/architect/skills/spec-and-plan",
        "../../resources/agents/architect/skills/software-architecture",
        "../../resources/agents/architect/skills/domain-modeling",
        "../../resources/skills/conventional-commits",
        "../../resources/skills/evidence-based-debugging",
        "../../resources/skills/linear-context"
      ],
      "config": {
        "thinking": "high"
      },
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true
      }
    },
    {
      "name": "architecture_reviewer",
      "path": "../../resources/agents/architecture_reviewer",
      "skills": [
        "../../orchestrator/comms/skills/task-comms",
        "../../resources/agents/architecture_reviewer/skills/architecture-challenge",
        "../../resources/skills/conventional-commits",
        "../../resources/skills/evidence-based-debugging",
        "../../resources/skills/linear-context"
      ],
      "config": {
        "thinking": "high"
      },
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true
      }
    },
    {
      "name": "coder_golang",
      "path": "agents/coder_golang",
      "skills": [
        "../../orchestrator/comms/skills/task-comms",
        "agents/coder_golang/skills/go-implementation",
        "skills/go-code-quality",
        "skills/go-testing",
        "skills/go-concurrency",
        "../../resources/skills/conventional-commits",
        "../../resources/skills/evidence-based-debugging",
        "../../resources/skills/bounded-iteration"
      ],
      "mcps": [
        "gopls",
        "comms"
      ],
      "extensions": [
        "ralph"
      ],
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true,
        "require_checks": true
      }
    },
    {
      "name": "code_reviewer_golang",
      "path": "agents/code_reviewer_golang",
      "skills": [
        "../../orchestrator/comms/skills/task-comms",
        "agents/code_reviewer_golang/skills/go-review",
        "agents/code_reviewer_golang/skills/critical-code-review",
        "skills/go-code-quality",
        "skills/go-testing",
        "skills/go-concurrency",
        "../../resources/skills/conventional-commits",
        "../../resources/skills/evidence-based-debugging",
        "../../resources/skills/linear-context"
      ],
      "mcps": [
        "gopls",
        "comms"
      ],
      "config": {
        "thinking": "high"
      },
      "handoff": {
        "require_artifacts": true,
        "require_limitations": true,
        "require_checks": true
      }
    }
  ]
}
